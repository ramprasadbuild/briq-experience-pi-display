[Unit]
Description=BriQ Experience Center - Pi display daemon
After=network-online.target
Wants=network-online.target
# Must be up before the kiosk browser tries to load http://localhost:8080/idle.
Before=briq-kiosk.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/briq-experience-pi-display
ExecStart=/usr/bin/node src/daemon.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Override per deployment if these ever differ from the defaults in src/config.js:
# Environment=API_BASE_URL=https://briq-crm-app-hiw6sglj2q-ue.a.run.app
# Environment=WEB_APP_ORIGIN=https://briq-crm-app.web.app

[Install]
WantedBy=multi-user.target
