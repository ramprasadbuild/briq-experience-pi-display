[Unit]
Description=BriQ TV box daemon (sync, local server, relay)
# Deliberately not waiting for network-online: the box must come up and present offline.
After=network.target
Before=briq-kiosk.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
Environment=BRIQ_DATA_DIR=/var/lib/briq-display
Environment=BRIQ_PORT=8787
# API_BASE_URL, MAPBOX_TOKEN, BRIQ_* overrides live here (written by install.sh):
EnvironmentFile=-/etc/default/briq-display
# /var/lib/briq-display, owned by @USER@. Holds device.json (0600) and content/.
StateDirectory=briq-display
StateDirectoryMode=0750
ExecStart=/usr/bin/node src/daemon.js
Restart=always
RestartSec=3
# restart_browser / reboot commands use `sudo -n systemctl …` (see /etc/sudoers.d/briq-display),
# so NoNewPrivileges must stay off.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
