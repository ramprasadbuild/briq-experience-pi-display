[Unit]
Description=BriQ TV kiosk (cage + Chromium on the local TV app)
After=systemd-user-sessions.service plymouth-quit-wait.service briq-display-daemon.service
# Wants, not Requires: restarting the daemon must not tear down the browser; the TV app reconnects.
Wants=briq-display-daemon.service
Conflicts=getty@tty7.service

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
EnvironmentFile=-/etc/default/briq-kiosk
ExecStartPre=+/usr/bin/chvt 7
# cage: a Wayland compositor that runs exactly one fullscreen app, no desktop underneath.
ExecStart=/usr/bin/cage -d -- @APP_DIR@/scripts/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
