[Unit]
Description=BriQ Experience Center - kiosk browser (cage + Chromium)
After=briq-display-daemon.service
Requires=briq-display-daemon.service

[Service]
Type=simple
User=pi
# cage is a minimal Wayland compositor that runs exactly one fullscreen app — there is no
# desktop environment underneath this, which is the point.
ExecStart=/usr/bin/cage -- /usr/bin/chromium-browser \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --autoplay-policy=no-user-gesture-required \
  --remote-debugging-port=9222 \
  --check-for-update-interval=31536000 \
  http://localhost:8080/idle
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
